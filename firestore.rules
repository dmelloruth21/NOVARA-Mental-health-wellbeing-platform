rules_version = '2';

// Novara Mental Health Platform — Backend-only Firestore Security Rules
// =========================================================================
// The frontend (React) never connects to Firestore directly. It communicates
// exclusively through the FastAPI backend (backend/src/app/chat_api.py and
// wellness_service.py), which authenticates with the Firebase Admin SDK.
//
// Admin SDK calls bypass ALL security rules, so these rules only govern
// direct client-SDK (web/mobile) access. We deny everything to ensure the
// database is accessible solely through the authenticated backend.
//
// Deployed via: Firebase Console → Firestore Database → Rules tab → Publish
// (or `firebase deploy --only firestore:rules` if using the Firebase CLI)
//
// Rollback / Disablement Path
// ---------------------------
// If Cloud Firestore needs to be disabled or becomes unreachable, the backend
// automatically falls back to local JSON storage in database/wellness_local/{uid}/
// (see LocalWellnessStore in wellness_service.py). This happens with zero
// downtime and no code changes — the get_firestore_client() probe detects the
// outage on the first wellness request and caches the fallback decision.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
